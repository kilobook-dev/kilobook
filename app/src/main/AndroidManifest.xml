<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pleos Vehicle SDK: Odometer API (@RequiresPermission = CAR_DRIVE, protection level normal) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />

    <!-- AAOS standard: GEAR_SELECTION, CURRENT_GEAR, PARKING_BRAKE_ON, IGNITION_STATE (protection level normal) -->
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- AAOS vendor property VENDOR_GEAR_SELECTION (0x21400400), which the Virtual Console publishes.
         This permission is signature|privileged, so it is expected to be denied. Declared only to record the result. -->
    <uses-permission android:name="android.car.permission.CAR_VENDOR_EXTENSION" />

    <!-- Background recording (Phase 3 B). specialUse: no standard type fits "observe vehicle odometer".
         The production type needs confirmation from Pleos. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <application
        android:name=".OdologApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Distraction Optimization (DO) declaration.
                 Pleos policy: apps without DO cannot be used while driving.
                 The spike needs the live panel to stay visible while driving. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>

        <service
            android:name=".service.RecorderService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Records driving trips from the vehicle odometer and gear while the app is not on screen" />
        </service>
    </application>

</manifest>
